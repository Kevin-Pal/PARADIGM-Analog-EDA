simulator lang=spectre
global 0
; NOTE: replace with your own PDK model file. Original: CSMC 0.18um, sm1816m50v13_usage.scs, section=tt_lib
include "/path/to/your/pdk/model.scs" section=tt_lib

subckt AZC VINN VINP VOUT IBIAS VDD VSS
C5 (net125 VSS) capacitor c=2.186e-12 m=1 //// *C_z*
C0 (net135 VOUT) capacitor c=1.467e-12 m=1 //// Miller cap
NM17 (VOUT net053 VSS VSS) mn18 w=1.969e-05 l=1.423e-06 m=45 //// *Input* *gm3*
